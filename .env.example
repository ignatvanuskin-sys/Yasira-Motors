# YASIRA MOTORS — конфигурация окружения
# Скопируйте в .env (или задайте переменные в панели хостинга).
# Значения по умолчанию берутся из подтверждённых данных о бизнесе (2GIS, yasira.kz).

# ─── Основное ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# Публичный адрес сайта (для canonical, OG, sitemap)
SITE_URL=https://yasira-motors.kz

# ─── Контакты (подтверждено: 2GIS 70000001029237438) ─────────────────────────
BUSINESS_PHONE=+7 777 088 44 36
BUSINESS_PHONE_2=+7 777 088 44 24
BUSINESS_PHONE_3=+7 777 088 44 08
# Только цифры, для wa.me
BUSINESS_WHATSAPP=77770884436
BUSINESS_EMAIL=info@yasira.kz
BUSINESS_EMAIL_SALES=magazine@yasira.kz
BUSINESS_INSTAGRAM=https://instagram.com/yasira_motors
BUSINESS_2GIS=https://2gis.kz/aktau/firm/70000001029237438

# ─── Адрес и геолокация (подтверждено: 2GIS) ─────────────────────────────────
BUSINESS_ADDRESS=Актау, 25-й микрорайон, 52/2
BUSINESS_LAT=43.654702
BUSINESS_LON=51.184709

# ─── График работы ───────────────────────────────────────────────────────────
# Формат: БЛОКИ через ';' → "дни|открытие|закрытие". Дни: 1=Пн … 7=Вс
BUSINESS_HOURS=1-6|09:00|20:00;7|10:00|17:00

# ─── Онлайн-запись ───────────────────────────────────────────────────────────
# Шаг слотов в минутах и сколько машин сервис принимает в один слот.
# ВНИМАНИЕ: capacity — это ёмкость приёмки в один слот. Значение по умолчанию
# консервативное; уточните у администратора и задайте реальное.
BOOKING_SLOT_MINUTES=60
BOOKING_CAPACITY=1
# На сколько дней вперёд открыта запись
BOOKING_HORIZON_DAYS=30
# Минимальный запас до начала записи (минут)
BOOKING_LEAD_MINUTES=60

# ─── Админка ─────────────────────────────────────────────────────────────────
# ОБЯЗАТЕЛЬНО задайте свой пароль. Хеш можно получить: npm run hash-password
ADMIN_PASSWORD=change-me
# Секрет для подписи сессионных cookie. Сгенерируйте: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-too

# ─── Уведомления администратору в Telegram ───────────────────────────────────
# Если переменные не заданы — уведомления просто отключаются, сайт работает.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Хранилище ───────────────────────────────────────────────────────────────
# Путь к файлу базы. На платформах с read-only ФС смонтируйте постоянный диск
# или подключите внешнее хранилище (см. README §Хранилище).
DATA_FILE=./data/db.json
